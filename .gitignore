# ==============================================================================
# SECRETS & CREDENTIALS / СЕКРЕТЫ И ТОКЕНЫ (КРИТИЧЕСКИ ВАЖНО)
# ==============================================================================
.env
.env.local
.streamlit/secrets.toml

# ==============================================================================
# REAL PRODUCTION DATABASE / БОЕВАЯ БАЗА САЙТОВ
# ==============================================================================
# Keeps your live domain fleet strictly on your local machine
# Ваши реальные сайты, IP и зоны никогда не попадут в публичный репозиторий
config.yaml

# ==============================================================================
# TERRAFORM ENGINE, CACHES & WORKSPACES / БИНАРНИКИ И СТЕЙТ ТЕРРАФОРМА
# ==============================================================================
terraform.exe
terraform.rc
tf_plugin_cache/

# Shared master core is fully generated at runtime by TemplateEngine
# Вся папка генерируется кодом автоматически, игнорируем ее целиком
_shared_tf/

# Isolated tenant workspaces containing 15-year RSA keys and .tfstate
# Изолированные папки сайтов с приватными ключами и файлами состояния
sites/

# General Terraform state safeguards & lockfiles
*.tfstate
*.tfstate.*
*.tfplan
*.lock.hcl
crash.log

# ==============================================================================
# PYTHON RUNTIME & ENVIRONMENT / ОКРУЖЕНИЕ И БАЙТКОД PYTHON
# ==============================================================================
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.log

# ==============================================================================
# IDE, EDITORS & OS METADATA / МУСОР ОПЕРАЦИОННЫХ СИСТЕМ И РЕДАКТОРОВ
# ==============================================================================
.idea/
.vscode/
*.swp
*.swo
*~
