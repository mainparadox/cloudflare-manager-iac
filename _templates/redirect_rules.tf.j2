# ==============================================================================
# SINGLE REDIRECT RULESET (EDGE-LEVEL DYNAMIC URI FORWARDING)
# ==============================================================================
resource "cloudflare_ruleset" "domain_redirect" {
  zone_id     = var.zone_id
  name        = "default"
  description = "Redirect all requests to {{ target_site }}{{ target_path }}"
  kind        = "zone"
  phase       = "http_request_dynamic_redirect"

  rules = [
    {
      action = "redirect"
      action_parameters = {
        from_value = {
          status_code = 301
          target_url = {
            expression = "concat(\"https://{{ target_site }}{{ target_path }}\", http.request.uri.path)"
          }
          preserve_query_string = true
        }
      }
      # NOTE: Expression "true" activates Cloudflare's "All incoming requests" policy,
      # capturing apex, www, and subdomains without requiring multi-clause Wirefilter evaluations.
      expression  = "true"
      description = "Redirect to {{ target_site }}{{ target_path }}"
      enabled     = true
    }
  ]
}